<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>台股月K創新高雷達 ｜ {{ data_date }}{% if not is_today %}（封存）{% endif %}</title>
<style>
  :root{
    --bg:#f5f6f8; --card:#ffffff; --ink:#1a1d21; --muted:#6b7280;
    --border:#e6e8eb; --accent:#2563eb;
    --up:#e2342d; --down:#11a675; --flat:#6b7280;
    --new:#e2342d; --near:#f59e0b; --pull:#eab308;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:"Microsoft JhengHei","PingFang TC","Noto Sans TC",-apple-system,
      BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    line-height:1.5;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1140px;margin:0 auto;padding:20px 16px 60px}
  header.hero{padding:8px 2px 14px}
  .hero h1{margin:0;font-size:24px;letter-spacing:.5px}
  .hero .sub{color:var(--muted);font-size:14px;margin-top:4px}
  .hero .meta{margin-top:8px;font-size:13px;color:var(--muted)}
  .hero .meta b{color:var(--ink)}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 6px}
  .chip{background:var(--card);border:1px solid var(--border);border-radius:999px;
    padding:6px 12px;font-size:13px}
  .chip b{font-size:14px}
  .legend{background:var(--card);border:1px solid var(--border);border-radius:12px;
    padding:12px 14px;margin:12px 0 4px;font-size:13px;color:var(--muted)}
  .legend .row{margin:3px 0}
  .legend b{color:var(--ink)}
  .focus{display:flex;gap:10px;align-items:flex-start;background:#eef4ff;
    border:1px solid #cfe0ff;border-radius:12px;padding:12px 14px;margin:14px 0 4px;font-size:14px}
  .focus-ic{font-size:18px;line-height:1.3}
  .focus b{color:var(--ink)}
  .focus-txt{color:#33415c;margin-top:2px}
  .news{background:var(--card);border:1px solid var(--border);border-radius:12px;
    padding:14px 16px;margin:14px 0 4px}
  .news h2{margin:0 0 6px;font-size:15px;display:flex;align-items:center;gap:7px}
  .news .take{color:#7c2d12;font-size:13.5px;background:#fff7ed;border:1px solid #fed7aa;
    border-radius:8px;padding:7px 10px;margin:0 0 10px}
  .news ol{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px}
  .news li{font-size:14px;line-height:1.55}
  .news .who{display:inline-block;font-size:11.5px;font-weight:700;color:#b45309;
    background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.35);
    border-radius:6px;padding:0 7px;margin-right:7px;white-space:nowrap}
  .news .why{color:var(--muted);font-size:12.5px;margin-top:2px}
  .news .src{font-size:12px;margin-top:3px}
  .news .src a{color:var(--accent);text-decoration:none}
  .news .src a:hover{text-decoration:underline}
  .news .tm{color:#9aa1ab;font-size:11.5px;margin-left:6px}
  .chips.groups{margin-top:10px}
  .chip.g{background:#f0f5ff;border-color:#d6e2ff;cursor:pointer;user-select:none;font:inherit}
  .chip.g:hover{background:#e2ecff}
  .chip.g.active{background:var(--accent);color:#fff;border-color:var(--accent)}
  .chip.lu{background:rgba(245,158,11,.12);border-color:rgba(245,158,11,.4);color:#b45309;
    cursor:pointer;user-select:none;font:inherit}
  .chip.lu:hover{background:rgba(245,158,11,.22)}
  .chip.lu.active{background:#f59e0b;color:#fff;border-color:#f59e0b}
  .chip .hint{font-size:11px;opacity:.7;margin-left:4px}
  .chip.nw{background:rgba(226,52,45,.08);border-color:rgba(226,52,45,.3);color:var(--up);
    cursor:pointer;user-select:none;font:inherit}
  .chip.nw:hover{background:rgba(226,52,45,.16)}
  .chip.nw.active{background:var(--up);color:#fff;border-color:var(--up)}
  .gt{color:var(--muted);font-size:12px;margin-top:2px}
  .nav{margin-top:8px;font-size:13px}
  .nav a{color:var(--accent);text-decoration:none;font-weight:600}
  .nav a:hover{text-decoration:underline}
  .badge-new{display:inline-block;background:var(--up);color:#fff;border-radius:5px;
    padding:0 5px;font-size:10px;font-weight:700;margin-left:6px;vertical-align:middle}
  .tag{display:inline-block;font-size:11px;font-weight:600;border-radius:5px;
    padding:1px 6px;line-height:1.6;white-space:nowrap}
  .tag.new{background:rgba(226,52,45,.10);color:var(--new);border:1px solid rgba(226,52,45,.30)}
  .tag.near{background:rgba(245,158,11,.12);color:#b45309;border:1px solid rgba(245,158,11,.35)}
  .tag.pull{background:rgba(234,179,8,.14);color:#a16207;border:1px solid rgba(234,179,8,.40)}
  .toolbar{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin:18px 0 6px}
  .toolbar input,.toolbar select{border:1px solid var(--border);border-radius:8px;padding:8px 12px;
    font-size:14px;background:var(--card);color:var(--ink)}
  .toolbar input{width:240px;max-width:60vw}
  .toolbar select{max-width:50vw;cursor:pointer}
  .table-wrap{overflow-x:auto;background:var(--card);border:1px solid var(--border);
    border-radius:12px}
  table{border-collapse:collapse;width:100%;min-width:720px}
  thead th{position:sticky;top:0;background:#fafbfc;z-index:1;text-align:right;
    font-size:12.5px;color:var(--muted);font-weight:600;padding:10px 12px;
    border-bottom:1px solid var(--border);white-space:nowrap}
  thead th[data-key]{cursor:pointer;user-select:none}
  thead th[data-key]:hover{color:var(--ink)}
  thead th[data-key].asc::after{content:" ▲";font-size:10px}
  thead th[data-key].desc::after{content:" ▼";font-size:10px}
  th.l,td.l{text-align:left}
  td{padding:9px 12px;text-align:right;border-bottom:1px solid #f0f1f3;
    font-variant-numeric:tabular-nums;white-space:nowrap}
  tbody tr:last-child td{border-bottom:none}
  tbody tr:hover{background:#fafbfc}
  .stock .code{font-weight:700;font-size:14px}
  .stock .nm{color:var(--ink);font-size:13px;margin-left:6px}
  .mk{display:inline-block;font-size:11px;color:var(--muted);border:1px solid var(--border);
    border-radius:4px;padding:0 5px;margin-left:6px;vertical-align:middle}
  .up{color:var(--up)} .down{color:var(--down)} .flat{color:var(--flat)}
  .badge-lu{display:inline-block;background:rgba(226,52,45,.1);color:var(--up);
    border:1px solid rgba(226,52,45,.25);border-radius:6px;padding:1px 7px;font-size:12px;font-weight:600}
  .none{color:#c3c7cd}
  td.chart{padding:5px 10px}
  td.chart img{display:block;height:62px;width:auto;border-radius:6px}
  .empty{background:var(--card);border:1px dashed var(--border);border-radius:12px;
    padding:40px;text-align:center;color:var(--muted)}
  footer{margin-top:34px;color:var(--muted);font-size:12px;line-height:1.7;
    border-top:1px solid var(--border);padding-top:14px}
  @media (max-width:640px){
    .hero h1{font-size:20px} td.chart img{height:50px} .stock .nm{display:block;margin-left:0}
  }
</style>
</head>
<body>
<div class="wrap">
  <header class="hero">
    <h1>📈 台股月K創新高雷達</h1>
    <div class="sub">以「還原月K」找出趨勢向上、處於歷史高檔的個股</div>
    <div class="meta">資料日期 <b>{{ data_date }}</b> ｜ 更新時間 <b>{{ update_time }}</b>（台灣時間）</div>
    <div class="nav">
      {% if home_link %}<a href="{{ home_link }}">← 回今日</a> ｜ {% endif %}
      {% if history_link %}<a href="{{ history_link }}">📅 歷史封存</a>{% endif %}
    </div>
  </header>

  <div class="chips">
    {% if total_scanned %}<div class="chip">掃描 <b>{{ total_scanned }}</b> 檔</div>{% endif %}
    <div class="chip">符合 <b>{{ total_hits }}</b> 檔</div>
    {% if new_count %}<button type="button" id="newChip" class="chip nw" onclick="toggleNewOnly()" title="點一下只看今日新增,再點還原全部">🆕 今日新增 <b>{{ new_count }}</b><span class="hint">點我篩選</span></button>{% endif %}
    {% if rows|selectattr('limit_up')|list %}<button type="button" id="limitChip" class="chip lu" onclick="toggleLimitOnly()" title="點一下只看近5日曾漲停的,再點還原全部">⚡ 近5日漲停 <b>{{ rows|selectattr('limit_up')|list|length }}</b><span class="hint">點我篩選</span></button>{% endif %}
    <div class="chip">成交金額 ≥ <b>{{ liquidity_str }}</b></div>
    <div class="chip">新高基準 <b>還原權值月K</b></div>
  </div>

  {% if news_items %}
  <div class="news">
    <h2>🌍 今日國際重點</h2>
    {% if news_takeaway %}<div class="take">{{ news_takeaway }}</div>{% endif %}
    <ol>
      {% for n in news_items %}
      <li>
        <div><span class="who">{{ n.who }}</span>{{ n.summary }}</div>
        {% if n.why %}<div class="why">{{ n.why }}</div>{% endif %}
        <div class="src">
          {% if n.link %}<a href="{{ n.link }}" target="_blank" rel="noopener">來源{% if n.source %}：{{ n.source }}{% endif %} ↗</a>{% elif n.source %}{{ n.source }}{% endif %}
          {% if n.time %}<span class="tm">{{ n.time }}</span>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
  {% endif %}

  {% if focus %}
  <div class="focus">
    <span class="focus-ic">🎯</span>
    <div><b>今日族群焦點</b><div class="focus-txt">{{ focus }}</div></div>
  </div>
  {% endif %}
  {% if group_counts %}
  <div class="chips groups">
    {% for g in group_counts %}<button type="button" class="chip g" data-group="{{ g.name }}" onclick="setGroup(this.dataset.group)" title="點一下只看此族群,再點還原"><b>{{ g.name }}</b> {{ g.count }}</button>{% endfor %}
  </div>
  {% endif %}

  <div class="legend">
    <div class="row"><b>篩選條件</b>：還原月K處於歷史新高 / 逼近新高 / 高檔修正，且當日成交金額達門檻、收盤站上 12 月均線。</div>
    <div class="row"><b>還原月K</b>：把歷年配息、配股還原後的月K線，這樣才看得出真正的歷史新高（除權息不會被誤判成跌破）。</div>
  </div>

  {% if total_hits == 0 %}
    <div class="empty">今日無符合條件的個股（可能為休市、或門檻過嚴）。</div>
  {% else %}
  <div class="toolbar">
    {% if group_counts %}
    <select id="groupSel" onchange="applyGroup(this.value)" title="依族群篩選">
      <option value="">全部族群（{{ total_hits }}）</option>
      {% for g in group_counts %}<option value="{{ g.name }}">{{ g.name }}（{{ g.count }}）</option>{% endfor %}
    </select>
    {% endif %}
    <input id="q" type="search" placeholder="搜尋代碼或股名…" oninput="applyFilters()">
  </div>

  <div class="table-wrap">
    <table class="sortable">
      <thead>
        <tr>
          <th class="l" data-key="code">代碼 / 股名</th>
          <th data-key="price">價格</th>
          <th data-key="change">漲跌幅</th>
          <th data-key="value" class="desc">成交金額</th>
          <th data-key="cap">市值</th>
          <th data-key="limit">近5日漲停</th>
          {% if show_charts %}<th>還原月K（36月）</th>{% endif %}
        </tr>
      </thead>
      <tbody>
        {% for r in rows %}
        <tr data-code="{{ r.code }}" data-name="{{ r.name }}"
            data-price="{{ r.close }}" data-change="{{ r.change }}"
            data-value="{{ r.trade_value }}" data-cap="{{ r.market_cap }}"
            data-limit="{{ r.limit_up_count }}" data-new="{{ '1' if r.new_today else '0' }}"
            data-group="{{ r.group }}">
          <td class="l stock">
            <span class="code">{{ r.code }}</span><span class="nm">{{ r.name }}</span>{% if r.new_today %}<span class="badge-new">🆕新</span>{% endif %}
            {% if r.group or r.theme %}<div class="gt">{{ r.group }}{% if r.theme %} · {{ r.theme }}{% endif %}</div>{% endif %}
          </td>
          <td>{{ r.close }}</td>
          <td class="{{ 'up' if r.up else 'down' }}">{{ r.change_str }}</td>
          <td>{{ r.trade_value_str }}</td>
          <td>{{ r.market_cap_str }}</td>
          <td>{% if r.limit_up %}<span class="badge-lu">漲停 ×{{ r.limit_up_count }}</span>{% else %}<span class="none">—</span>{% endif %}</td>
          {% if show_charts %}<td class="chart">{% if r.chart %}<img loading="lazy" alt="還原月K" src="{{ r.chart }}">{% else %}<span class="none">—</span>{% endif %}</td>{% endif %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <footer>
    <div>資料來源：TWSE / TPEX OpenAPI、Yahoo Finance（yfinance，還原權值月K）、FinMind（備援）、GitHub Models（族群題材／國際重點摘要）、Google News（國際重點來源）。</div>
    {% if not show_charts %}<div>此為歷史封存頁，不含月K縮圖；🆕新 表示相對前一交易日為新進榜。</div>{% endif %}
    <div>本頁由 TW_STOCK_RADAR 自動產生，僅供研究參考，不構成投資建議。漲停以收盤漲幅近似判斷，請以官方資料為準。</div>
    <div>產生時間：{{ update_time }}（台灣時間）</div>
  </footer>
</div>

<script>
let newOnly=false, limitOnly=false, groupFilter='';
function applyFilters(){
  const el=document.getElementById('q');
  const q=(el?el.value:'').trim().toLowerCase();
  document.querySelectorAll('tbody tr').forEach(tr=>{
    const matchQ = !q || (tr.dataset.code+' '+tr.dataset.name).toLowerCase().indexOf(q)>=0;
    const matchNew = !newOnly || tr.dataset.new==='1';
    const matchLimit = !limitOnly || parseFloat(tr.dataset.limit||'0')>0;
    const matchGroup = !groupFilter || tr.dataset.group===groupFilter;
    tr.style.display = (matchQ && matchNew && matchLimit && matchGroup) ? '' : 'none';
  });
}
function toggleNewOnly(){
  newOnly=!newOnly;
  const chip=document.getElementById('newChip');
  if(chip) chip.classList.toggle('active', newOnly);
  applyFilters();
}
function toggleLimitOnly(){
  limitOnly=!limitOnly;
  const chip=document.getElementById('limitChip');
  if(chip) chip.classList.toggle('active', limitOnly);
  applyFilters();
}
function applyGroup(g){
  groupFilter = g || '';
  const sel=document.getElementById('groupSel');
  if(sel) sel.value=groupFilter;
  document.querySelectorAll('.chip.g').forEach(c=>
    c.classList.toggle('active', c.dataset.group===groupFilter));
  applyFilters();
}
function setGroup(g){ applyGroup(groupFilter===g ? '' : g); }  // 點標籤可切換
// 相容舊呼叫
function filterRows(){ applyFilters(); }
document.querySelectorAll('th[data-key]').forEach(th=>{
  th.addEventListener('click',()=>{
    const table=th.closest('table'), tbody=table.tBodies[0], key=th.dataset.key;
    const asc=!th.classList.contains('asc');
    table.querySelectorAll('th').forEach(h=>h.classList.remove('asc','desc'));
    th.classList.add(asc?'asc':'desc');
    [...tbody.rows].sort((a,b)=>{
      const va=a.dataset[key], vb=b.dataset[key];
      const na=parseFloat(va), nb=parseFloat(vb);
      const cmp=(!isNaN(na)&&!isNaN(nb))?na-nb:(''+va).localeCompare(''+vb,'zh-Hant');
      return asc?cmp:-cmp;
    }).forEach(r=>tbody.appendChild(r));
  });
});
</script>
</body>
</html>
